{
  "name": "@zxlabs/hyperapp-extra",
  "version": "2.0.2",
  "description": "Utilities for Hyperapp apps",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite --config vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit"
  },
  "author": "Zacharias Enochsson",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "hyperapp": "^2.0.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.5",
    "hyperapp": "^2.0.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-hyperapp": "^2.0.4",
    "vitest": "^5.0.3"
  }
}
