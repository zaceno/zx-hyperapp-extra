{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "vite-plugin-hyperapp/jsx"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "demo/**/*.ts", "demo/**/*.tsx", "*.config.ts"]
}
